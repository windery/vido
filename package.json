{
  "name": "electron-vue-vite",
  "version": "0.1.0",
  "main": "dist-electron/main/index.js",
  "description": "Really simple Electron + Vue + Vite boilerplate.",
  "author": "windery <res.windery@gmail.com>",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:core": "vitest run src/renderer/domain src/renderer/i18n src/renderer/utils src/main",
    "test:ui": "vitest run src/renderer/components",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .vue,.js,.ts,.jsx,.tsx",
    "lint:fix": "eslint src --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "marked": "14.1.3",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@nabla/vite-plugin-eslint": "^2.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/devtools": "^6.6.3",
    "@vue/test-utils": "^2.4.6",
    "electron": "^29.4.6",
    "electron-builder": "^25.0.5",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.27.0",
    "globals": "^15.8.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.16.1",
    "vite": "^5.1.5",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.0.6"
  }
}
