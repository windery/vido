{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["element-plus/global"]
  },
  "include": ["src", "electron/domain/Shortcuts.ts", "electron/domain/command", "electron/domain/Command.ts"],
  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}
