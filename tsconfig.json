{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/*"],
      "@main/*": ["src/main/*"],
      "@domain/*": ["src/shared/domain/*"],
      "@components/*": ["src/renderer/components/*"],
      "@composables/*": ["src/renderer/composables/*"],
      "@utils/*": ["src/renderer/utils/*"]
    }
  },
  "include": [
    "src",
    "electron/domain/shortcuts.ts",
    "electron/domain/command",
    "electron/domain/Command.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}